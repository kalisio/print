{
  "name": "print-api",
  "description": "Kalisio Teams Web Services",
  "version": "1.0.0",
  "packageManager": "pnpm@10.34.5",
  "homepage": "https://github.com/kalisio/print",
  "keywords": [
    "kalisio"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git://github.com/kalisio/print.git"
  },
  "author": {
    "name": "Kalisio contributors",
    "url": "https://github.com/kalisio"
  },
  "contributors": [],
  "bugs": {
    "url": "https://github.com/kalisio/print/issues"
  },
  "type": "module",
  "main": "src/main.js",
  "scripts": {
    "release:patch": "npm --no-git-tag-version version patch",
    "release:minor": "npm --no-git-tag-version version minor",
    "release:major": "npm --no-git-tag-version version major",
    "dev": "cross-env NODE_ENV=development node --conditions=development --inspect --watch src/main.js",
    "debug": "cross-env NODE_ENV=development node --conditions=development --inspect src/main.js",
    "prod": "cross-env NODE_ENV=production node --conditions=development src/main.js",
    "lint": "standard src/**/*.js test/**/*.js --fix",
    "mocha": "cross-env NODE_OPTIONS=--conditions=development NODE_CONFIG_DIR=./test/config/ mocha",
    "coverage": "c8 node --run mocha",
    "test": "pnpm lint && pnpm coverage"
  },
  "standard": {
    "sourceType": "module",
    "env": [
      "mocha"
    ]
  },
  "dependencies": {
    "@feathersjs/authentication": "catalog:",
    "@feathersjs/express": "catalog:",
    "@feathersjs/feathers": "catalog:",
    "@kalisio/kdk": "catalog:",
    "feathers-hooks-common": "catalog:",
    "feathers-mongodb-fuzzy-search": "catalog:",
    "fs-extra": "catalog:",
    "http-proxy-middleware": "catalog:",
    "is-docker": "catalog:",
    "winston": "catalog:"
  },
  "devDependencies": {
    "c8": "^7.11.0",
    "chai": "^4.3.4",
    "chai-lint": "^0.1.1",
    "cross-env": "catalog:",
    "mocha": "^9.1.1",
    "standard": "catalog:"
  }
}
